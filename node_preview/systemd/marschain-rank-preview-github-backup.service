[Unit]
Description=MarsChain verified public daily snapshot backup to GitHub
After=network-online.target marschain-rank-preview-freeze.service

[Service]
Type=oneshot
WorkingDirectory=%h/marschain-rank-preview/app
EnvironmentFile=%h/.config/marschain-rank/github-backup.env
ExecStart=/usr/bin/python3 -m node_preview.github_backup --root %h/marschain-rank-preview
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
UMask=0077
TimeoutStartSec=20min

