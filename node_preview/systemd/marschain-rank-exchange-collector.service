[Unit]
Description=MarsChain KTX and LBank public spot market collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/marschain-rank-preview/app
ExecStart=/usr/bin/python3 -m node_preview.exchange_quotes --root %h/marschain-rank-preview --once
TimeoutStartSec=30
Nice=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
