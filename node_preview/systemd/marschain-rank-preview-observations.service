[Unit]
Description=MarsChain bounded recent-day statistics bootstrap
After=marschain-rank-preview-collector.service

[Service]
Type=oneshot
WorkingDirectory=%h/marschain-rank-preview/app
ExecStart=/usr/bin/python3 -m node_preview.observations --root %h/marschain-rank-preview --days 2 --workers 3
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
UMask=0077
TimeoutStartSec=30min
