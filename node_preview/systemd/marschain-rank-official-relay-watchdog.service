[Unit]
Description=MarsChain public Explorer receipt refresh watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/marschain-rank-preview/app
EnvironmentFile=%h/.config/marschain-rank/github-backup.env
ExecStart=/usr/bin/python3 -m node_preview.official_relay_watchdog --root %h/marschain-rank-preview
TimeoutStartSec=2min
Nice=10
NoNewPrivileges=true
UMask=0077
